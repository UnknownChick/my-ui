{
	"name": "myui",
	"description": "Extensible BEM-based SCSS component library with configurable design tokens and themes.",
	"version": "0.0.0",
	"type": "module",
	"style": "./dist/myui.css",
	"sass": "./src/scss/index.scss",
	"files": [
		"dist/myui.css",
		"src/scss/abstracts/",
		"src/scss/base/",
		"src/scss/components/",
		"src/scss/config/",
		"src/scss/layouts/",
		"src/scss/themes/",
		"src/scss/utilities/",
		"src/scss/_layers.scss",
		"src/scss/index.scss",
		"readme.md"
	],
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build && sass --no-source-map src/scss/index.scss dist/myui.css",
		"build:demo": "vite build",
		"build:scss": "sass --no-source-map src/scss/index.scss dist/myui.css",
		"prepack": "sass --no-source-map src/scss/index.scss dist/myui.css",
		"test": "node --test tests/*.test.js",
		"preview": "vite preview",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@fullhuman/postcss-purgecss": "^8.0.0",
		"autoprefixer": "^10.6.1",
		"browserslist": "^4.29.4",
		"lightningcss": "^1.33.0",
		"lucide": "^1.61.0",
		"postcss": "^8.5.31",
		"sass": "^1.106.1",
		"vite": "^8.3.5"
	}
}
